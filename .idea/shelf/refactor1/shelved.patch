<+><app-hero-section\r\n        heroClass=\"hero-offer\"\r\n        headline=\"TWÓJ STYL,<br>NASZE FARBY\"\r\n        mobileHeadline=\"TWÓJ STYL, NASZE FARBY\"\r\n        subtext=\"Tworzymy sztukę, która nadaje przestrzeni charakter.\"\r\n        mobileSubtext=\"Tworzymy sztukę, która nadaje przestrzeni charakter.\"\r\n        buttonLabel=\"Poznaj ofertę\"\r\n        mobileButtonLabel=\"Poznaj ofertę\"\r\n        [targetElement]=\"categoriesSection\"\r\n        buttonAriaLabel=\"Przewiń do treści\"\r\n        backgroundImageDesktop=\"/assets/images/bike/categories/layout/buty_desktop.png\"\r\n        backgroundImageMobile=\"/assets/images/bike/categories/layout/buty_mobile_cut.png\">\r\n</app-hero-section>\r\n\r\n<section class=\"offer\" #categoriesSection>\r\n  <h1 class=\"section-subtitle\">\r\n    SZTUKA AUTORSKA. NA&nbsp;PRZEDMIOTACH I&nbsp;W&nbsp;PRZESTRZENI.\r\n  </h1>\r\n\r\n  <!-- OBRAZY -->\r\n  <div class=\"offer__item offer__item--with-image offer__item--obrazy\">\r\n    <div class=\"offer__item-content\">\r\n      <h5 class=\"offer__item-title\">\r\n        OBRAZY – autorskie kompozycje tworzone na&nbsp;zamówienie\r\n      </h5>\r\n      <p class=\"offer__item-description\">\r\n        Tworzymy obrazy dopasowane do wnętrza, osobowości i&nbsp;estetyki właściciela.\r\n        Każda realizacja powstaje od koncepcji, przez szkic, po finalne wykończenie – bez szablonów i&nbsp;powtórzeń.\r\n      </p>\r\n      <ul>\r\n        <li><strong>Pejzaże, abstrakcja, sztuka nowoczesna</strong></li>\r\n        <li><strong>Format i kolorystyka</strong> dopasowane do przestrzeni</li>\r\n        <li><strong>Autorski projekt</strong> tworzony indywidualnie</li>\r\n      </ul>\r\n    </div>\r\n\r\n    <div class=\"offer__item-image\">\r\n      <img src=\"/assets/images/art/offer/obraz.png\" alt=\"Autorski obraz na zamówienie\" loading=\"lazy\" width=\"260\" height=\"180\" />\r\n    </div>\r\n  </div>\r\n\r\n  <!-- MURALE -->\r\n  <div class=\"offer__item offer__item--with-image offer__item--murale\">\r\n    <div class=\"offer__item-content\">\r\n      <h5 class=\"offer__item-title\">\r\n        MURALE – sztuka w dużym formacie\r\n      </h5>\r\n      <p class=\"offer__item-description\">\r\n        Projektujemy i realizujemy murale w&nbsp;przestrzeniach prywatnych oraz komercyjnych.\r\n        Tworzymy kompozycje, które definiują klimat wnętrza lub budynku i budują jego unikalną tożsamość.\r\n      </p>\r\n      <ul>\r\n        <li><strong>Wnętrza prywatne, studia, lokale usługowe</strong></li>\r\n        <li><strong>Projekt dopasowany do architektury</strong></li>\r\n        <li><strong>Realizacja od koncepcji po finalne wykonanie</strong></li>\r\n      </ul>\r\n    </div>\r\n\r\n    <div class=\"offer__item-image\">\r\n      <img src=\"/assets/images/art/offer/mural.png\" alt=\"Artystyczny mural ścienny\" loading=\"lazy\" width=\"260\" height=\"180\" />\r\n    </div>\r\n  </div>\r\n\r\n  <!-- DREWNO / RZEŹBY -->\r\n  <div class=\"offer__item offer__item--with-image offer__item--rzezby\" data-scroll-reveal=\"left\">\r\n    <div class=\"offer__item-content\">\r\n      <h5 class=\"offer__item-title\">\r\n        DREWNO – formy, które ożywiają przestrzeń\r\n      </h5>\r\n      <p class=\"offer__item-description\">\r\n        Tworzymy i personalizujemy drewniane elementy użytkowe oraz dekoracyjne.\r\n        Każdy projekt podkreśla naturalną strukturę materiału i łączy rzemiosło z nowoczesną estetyką.\r\n      </p>\r\n      <ul>\r\n        <li><strong>Deski, misy, elementy dekoracyjne</strong></li>\r\n        <li><strong>Autorskie kompozycje kolorystyczne</strong></li>\r\n        <li><strong>Ręczne wykończenie</strong> z dbałością o&nbsp;detal</li>\r\n      </ul>\r\n    </div>\r\n\r\n    <div class=\"offer__item-image\">\r\n      <img src=\"/assets/images/art/offer/rzezby.png\" alt=\"Artystyczne realizacje w drewnie\" loading=\"lazy\" width=\"260\" height=\"180\" />\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ODZIEŻ -->\r\n  <div class=\"offer__item offer__item--with-image offer__item--odziez\" data-scroll-reveal=\"right\">\r\n    <div class=\"offer__item-content\">\r\n      <h5 class=\"offer__item-title\">\r\n        ODZIEŻ – sztuka, którą możesz nosić\r\n      </h5>\r\n      <p class=\"offer__item-description\">\r\n        Tworzymy autorskie projekty na&nbsp;odzieży codziennej i lifestyle’owej.\r\n        To propozycja dla osób, które chcą wyróżniać się subtelną, ale wyrazistą formą.\r\n      </p>\r\n      <ul>\r\n        <li><strong>Bawełna i tkaniny naturalne</strong> – idealne pod realizacje artystyczne</li>\r\n        <li><strong>Indywidualny projekt</strong> dopasowany do stylu właściciela</li>\r\n        <li><strong>Trwałe wykończenie</strong> odporne na użytkowanie</li>\r\n      </ul>\r\n    </div>\r\n\r\n    <div class=\"offer__item-image\">\r\n      <img src=\"/assets/images/art/offer/odziez.png\" alt=\"Autorska odzież artystyczna\" loading=\"lazy\" width=\"260\" height=\"180\" />\r\n    </div>\r\n  </div>\r\n\r\n  <!-- MOTORYZACJA -->\r\n  <div class=\"offer__item offer__item--with-image offer__item--moto\" data-scroll-reveal=\"left\">\r\n    <div class=\"offer__item-content\">\r\n      <h5 class=\"offer__item-title\">\r\n        MOTORYZACJA – sztuka w ruchu\r\n      </h5>\r\n      <p class=\"offer__item-description\">\r\n        Realizujemy projekty artystyczne na&nbsp;elementach pojazdów – subtelne detale lub wyraziste kompozycje.\r\n        To&nbsp;propozycja dla właścicieli, którzy chcą nadać maszynie osobisty charakter.\r\n      </p>\r\n      <ul>\r\n        <li><strong>Elementy motocykli i samochodów</strong></li>\r\n        <li><strong>Detale podkreślające linię pojazdu</strong></li>\r\n        <li><strong>Więcej na: lussoart.pl/moto</strong></li>\r\n      </ul>\r\n    </div>\r\n\r\n    <div class=\"offer__item-image\">\r\n      <img src=\"/assets/images/art/offer/moto.png\" alt=\"Artystyczne projekty motoryzacyjne\" loading=\"lazy\" width=\"260\" height=\"180\" />\r\n    </div>\r\n  </div>\r\n\r\n  <!-- SPRZĘT SPORTOWY -->\r\n  <div class=\"offer__item offer__item--with-image offer__item--sport\" data-scroll-reveal=\"right\">\r\n    <div class=\"offer__item-content\">\r\n      <h5 class=\"offer__item-title\">\r\n        SPRZĘT SPORTOWY&nbsp;– personalizacja z&nbsp;charakterem\r\n      </h5>\r\n      <p class=\"offer__item-description\">\r\n        Nadajemy indywidualny styl kaskom, łyżwom, wrotkom i&nbsp;innym elementom wyposażenia.\r\n        To&nbsp;propozycja dla osób, które chcą, by&nbsp;ich sprzęt był równie wyrazisty jak ich ambicje.\r\n      </p>\r\n      <ul>\r\n        <li><strong>Kaski, łyżwy, wrotki</strong></li>\r\n        <li><strong>Autorskie grafiki i&nbsp;detale</strong></li>\r\n        <li><strong>Więcej na: lussoart.pl/bike</strong></li>\r\n      </ul>\r\n    </div>\r\n\r\n    <div class=\"offer__item-image\">\r\n      <img src=\"/assets/images/art/offer/sport.png\" alt=\"Personalizowany sprzęt sportowy\" loading=\"lazy\" width=\"260\" height=\"180\" />\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"about__contact\">\r\n    <p><strong>Masz wizję, której nie&nbsp;da&nbsp;się kupić w&nbsp;sklepie?<br>\r\n      Chcesz, aby Twoja przestrzeń lub przedmiot były czymś więcej niż standardem?</strong></p>\r\n\r\n    <p>Napisz do&nbsp;nas.<br>\r\n      Stworzymy projekt, który będzie mówił Twoim językiem.</p>\r\n  </div>\r\n\r\n  <div class=\"about__cta\">\r\n    <app-cta-button\r\n            label=\"Przykładowe realizacje\"\r\n            mobileLabel=\"Przykładowe realizacje\"\r\n            routerLink=\"/art/projects\"\r\n            ariaLabel=\"Przykładowe realizacje\">\r\n    </app-cta-button>\r\n  </div>\r\n</section>\r\n
