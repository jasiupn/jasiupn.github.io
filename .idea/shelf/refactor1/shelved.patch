<+>@import '../../../../styles.scss';\r\n\r\n:host {\r\n  display: block;\r\n}\r\n\r\n.offer {\r\n  margin: 0;\r\n  padding-top: $hero-to-subtitle-spacing;\r\n  padding-left: 1rem;\r\n  padding-right: 1rem;\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n\r\n  @media (min-width: $breakpoint-md) {\r\n    padding-left: 2rem;\r\n    padding-right: 2rem;\r\n  }\r\n\r\n  line-height: 1.6;\r\n  font-size: $font-size-base;\r\n  color: $color-text;\r\n\r\n  .section-subtitle {\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n  }\r\n\r\n  &__title {\r\n    font-size: $font-size-xl;\r\n    font-weight: $font-weight-bold;\r\n    margin-bottom: 1rem;\r\n    text-align: center;\r\n    font-family: $font-family-hero-headline;\r\n  }\r\n\r\n  &__subtitle {\r\n    font-size: $font-size-base;\r\n    font-weight: $font-weight-semibold;\r\n    margin: 1.5rem 0 0.75rem;\r\n    text-transform: uppercase;\r\n    color: $color-text-light;\r\n    text-align: center;\r\n  }\r\n\r\n  &__section-title {\r\n    font-size: $font-size-base;\r\n    font-weight: $font-weight-semibold;\r\n    margin: 1rem 0 0.5rem;\r\n  }\r\n\r\n  &__intro {\r\n    margin-bottom: 1.5rem;\r\n     font-size: $font-size-base;\r\n  }\r\n\r\n  &__item {\r\n    margin: 2rem 0;\r\n    padding: 0;\r\n    background: transparent;\r\n    border: none;\r\n    border-radius: 0;\r\n  }\r\n\r\n  &__item--with-image {\r\n    position: relative;\r\n    display: block;\r\n    margin-left: -1rem;\r\n    margin-right: -1rem;\r\n    padding: 3rem 1rem;\r\n    min-height: 300px;\r\n    overflow: hidden;\r\n\r\n    @media (max-width: $breakpoint-md) {\r\n      &[data-scroll-reveal] {\r\n        opacity: 0;\r\n        transition: opacity 1s ease-out, transform 1s ease-out;\r\n      }\r\n\r\n      &[data-scroll-reveal=\"left\"] {\r\n        transform: translateX(-50px);\r\n      }\r\n\r\n      &[data-scroll-reveal=\"right\"] {\r\n        transform: translateX(50px);\r\n      }\r\n\r\n      &[data-scroll-reveal].is-visible {\r\n        opacity: 1;\r\n        transform: translateX(0);\r\n      }\r\n\r\n      &:not([data-scroll-reveal]) {\r\n        opacity: 1;\r\n        transform: translateX(0);\r\n      }\r\n    }\r\n\r\n    &::before {\r\n      content: '';\r\n      position: absolute;\r\n      inset: 0;\r\n      background-size: cover;\r\n      background-position: center;\r\n      background-repeat: no-repeat;\r\n      z-index: 0;\r\n    }\r\n\r\n    &::after {\r\n      content: '';\r\n      position: absolute;\r\n      inset: 0;\r\n      background: rgba(255, 255, 255, 0.70);\r\n      backdrop-filter: blur(1px);\r\n      z-index: 1;\r\n    }\r\n\r\n    &.offer__item--obrazy::before {\r\n      background-image: url('/assets/images/art/offer/obrazy_szkic.png');\r\n      filter: grayscale(100%) sepia(20%) opacity(0.5);\r\n    }\r\n\r\n    &.offer__item--murale::before {\r\n      background-image: url('/assets/images/art/offer/mural_szkic.png');\r\n      filter: grayscale(100%) sepia(20%) opacity(0.5);\r\n    }\r\n\r\n    &.offer__item--rzezby::before {\r\n      background-image: url('/assets/images/art/offer/rzezby_szkic.png');\r\n      filter: grayscale(100%) sepia(20%) opacity(0.5);\r\n    }\r\n\r\n    &.offer__item--odziez::before {\r\n      background-image: url('/assets/images/art/offer/odziez_szkic.png');\r\n      filter: grayscale(100%) sepia(20%) opacity(0.5);\r\n    }\r\n\r\n    &.offer__item--moto::before {\r\n      background-image: url('/assets/images/art/offer/moto_szkic.png');\r\n      filter: grayscale(100%) sepia(20%) opacity(0.5);\r\n    }\r\n\r\n    &.offer__item--sport::before {\r\n      background-image: url('/assets/images/art/offer/sport_szkic.png');\r\n      filter: grayscale(100%) sepia(20%) opacity(0.5);\r\n    }\r\n  }\r\n\r\n  &__item-content {\r\n    position: relative;\r\n    z-index: 2;\r\n    max-width: 600px;\r\n\r\n    /* Mobile: brak fiszki, czysty tekst na tle */\r\n    h5 {\r\n      font-size: $font-size-md;\r\n      font-weight: $font-weight-semibold;\r\n      margin-bottom: 0.75rem;\r\n      color: $color-text;\r\n    }\r\n\r\n    p {\r\n      margin-bottom: 1rem;\r\n      line-height: 1.6;\r\n      color: $color-text;\r\n    }\r\n\r\n    ul {\r\n      margin-top: 0.75rem;\r\n      padding-left: 1.5rem;\r\n\r\n      li {\r\n        margin-bottom: 0.5rem;\r\n        line-height: 1.5;\r\n      }\r\n    }\r\n\r\n    /* Desktop: fiszka z półprzezroczystym tłem */\r\n    @media (min-width: $breakpoint-md) {\r\n      background: rgba(255, 255, 255, 0.45);\r\n      backdrop-filter: blur(8px);\r\n      border-radius: 0.75rem;\r\n      padding: 1.75rem 1.5rem;\r\n      box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.08);\r\n\r\n      /* Żółty akcent tylko na desktop */\r\n      &::before {\r\n        content: '';\r\n        position: absolute;\r\n        top: 1.25rem;\r\n        left: 1.25rem;\r\n        width: 2.5rem;\r\n        height: 0.25rem;\r\n        background: $color-primary;\r\n        border-radius: 2px;\r\n        z-index: 1;\r\n      }\r\n\r\n      h5 {\r\n        margin-top: 0.5rem;\r\n      }\r\n    }\r\n  }\r\n\r\n  &__item-description {\r\n    font-size: $font-size-base; /* 18px */\r\n    margin-bottom: 1rem;\r\n    line-height: 1.6;\r\n    color: $color-text;\r\n    text-align: justify;\r\n  }\r\n\r\n  &__item-title {\r\n    font-size: $font-size-md;\r\n    font-weight: $font-weight-semibold;\r\n    margin-bottom: 0.75rem;\r\n  }\r\n\r\n  &__item-image {\r\n    position: relative;\r\n    z-index: 2;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-top: 1.5rem;\r\n    background: transparent;\r\n  }\r\n\r\n  &__item-image img {\r\n    width: 100%;\r\n    height: auto;\r\n    max-width: 200px;\r\n    transition: transform 0.45s ease;\r\n    will-change: transform;\r\n  }\r\n\r\n  &__item--with-image:hover &__item-image img {\r\n    transform: translateY(-0.3125rem) scale(1.05);\r\n  }\r\n\r\n  &__list {\r\n    margin: 1.5rem 0;\r\n    padding-left: 1.3rem;\r\n\r\n    li {\r\n      margin-bottom: 0.5rem;\r\n    }\r\n  }\r\n\r\n  &__contact {\r\n    margin-top: 1.5rem;\r\n    font-weight: $font-weight-semibold;\r\n    font-size: $font-size-base;\r\n    text-align: center;\r\n  }\r\n}\r\n\r\n.about__contact {\r\n  margin-top: 2rem;\r\n  text-align: center;\r\n\r\n  p {\r\n    margin-bottom: 1rem;\r\n  }\r\n\r\n  strong {\r\n    font-weight: $font-weight-semibold;\r\n    font-size: $font-size-base;\r\n  }\r\n}\r\n\r\n.about__cta {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-top: 2rem;\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n.categories__tile {\r\n  transition: transform 0.25s ease, box-shadow 0.25s ease;\r\n\r\n  &:hover {\r\n    transform: translateY(-0.375rem);\r\n    box-shadow: 0 0.875rem 1.875rem rgba(0, 0, 0, 0.15);\r\n  }\r\n}\r\n\r\n@media (min-width: $breakpoint-lg) {\r\n  .offer {\r\n    max-width: 56.25rem;\r\n    margin: 0 auto;\r\n    padding: $hero-to-subtitle-spacing-desktop 1rem 0 1rem;\r\n    font-size: $font-size-base;\r\n  }\r\n\r\n  .offer__title { font-size: $font-size-xl; margin-bottom: 1.5rem; }\r\n  .offer__subtitle { font-size: $font-size-lg; margin: 2.5rem 0 1rem; }\r\n  .offer__section-title { font-size: $font-size-md; margin: 2rem 0 1rem; }\r\n\r\n  .offer__item--with-image {\r\n    margin-left: calc(-50vw + 50%);\r\n    margin-right: calc(-50vw + 50%);\r\n    padding: 4rem calc(50vw - 50% + 2rem);\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr;\r\n    gap: 4rem;\r\n    align-items: center;\r\n    min-height: 400px;\r\n\r\n    &::before {\r\n      background: rgba(255, 255, 255, 0.68);\r\n      backdrop-filter: blur(0.5px);\r\n    }\r\n  }\r\n\r\n  .offer__item--kaski,\r\n  .offer__item--ramy,\r\n  .offer__item--inne {\r\n    .offer__item-content {\r\n      order: 2;\r\n    }\r\n\r\n    .offer__item-image {\r\n      order: 1;\r\n    }\r\n  }\r\n\r\n  .offer__item-content {\r\n    max-width: 100%;\r\n\r\n    h5 {\r\n      font-size: $font-size-lg;\r\n      margin-bottom: 1rem;\r\n    }\r\n\r\n    p {\r\n      font-size: $font-size-base;\r\n      line-height: 1.7;\r\n    }\r\n\r\n    ul li {\r\n      font-size: $font-size-base;\r\n    }\r\n  }\r\n\r\n  .offer__item-image {\r\n    margin-top: 0;\r\n\r\n    img {\r\n      max-width: 300px;\r\n    }\r\n  }\r\n\r\n  .about__contact {\r\n    margin-top: 2.5rem;\r\n  }\r\n}\r\n\r\n/* Tablet-ish breakpoint tweaks */\r\n@media (min-width: 601px) and (max-width: 900px) {\r\n  .offer { padding: 1.5rem 1rem; }\r\n\r\n  .offer__item--with-image {\r\n    padding: 3rem 2rem;\r\n    min-height: 350px;\r\n  }\r\n\r\n  .offer__item-image img {\r\n    max-width: 250px;\r\n  }\r\n}\r\n\r\n
